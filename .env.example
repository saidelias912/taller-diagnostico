# ---- App (Expo): se publican en el navegador, son claves PUBLICAS ----
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key
# Vacio en produccion web (misma URL). En celular/desarrollo: la URL de tu deploy en Vercel
EXPO_PUBLIC_API_URL=

# ---- Servidor (Vercel > Settings > Environment Variables). NO van en la app ----
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu_anon_key
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-5-5
DAILY_LLM_LIMIT=100
ALLOWED_ORIGIN=*
